# URL de la API compartida de Jemacash, sin barra final.
# Desarrollo local: API en 3000 y panel administrador en 5174.
# Para producción, reemplaza el valor por la URL HTTPS de tu API.
# Vite incorpora este valor al ejecutar npm run build.
# Las variables VITE_* son públicas: usa únicamente configuración del navegador.
VITE_API_URL=http://localhost:3000

# Configuración necesaria en el .env del BACKEND (proyecto Server):
# ADMIN_FRONTEND_URL=http://localhost:5174
# Esta variable autoriza el origen del administrador mediante CORS.
